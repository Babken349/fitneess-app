# Скопируйте в .env: cp .env.example .env
# Значения ниже только для локальной разработки. Реальные пароли и ключи в репозиторий не коммитим.

# ---- PostgreSQL (контейнер db) ----
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=fitness

# ---- Подключение backend к базе ----
# Хост db это имя сервиса из docker-compose.yml, а не localhost.
# Логин, пароль и имя базы должны совпадать с блоком выше.
DATABASE_URL=postgresql+asyncpg://fitness:change_me_dev_only@db:5432/fitness
# База для тестов: имя обязательно заканчивается на _test
TEST_DATABASE_URL=postgresql+asyncpg://fitness:change_me_dev_only@db:5432/fitness_test

# ---- Секреты приложения ----
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=replace_with_output_of_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Почта (в dev письма не уходят, ключ-заглушка) ----
RESEND_API_KEY=re_dev_stub
EMAIL_FROM=dev@example.com
FRONTEND_URL=http://localhost:5500

# ---- CORS: адреса фронтенда через запятую ----
# localhost и 127.0.0.1 это разные origin, нужны оба, если открываете оба
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# ---- Порты на хосте ----
BACKEND_PORT=8000
DB_PORT=5433
FRONTEND_PORT=8080
# Путь к папке фронтенда для необязательного сервиса frontend
FRONTEND_DIR=../vyra-web
